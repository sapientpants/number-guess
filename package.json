{
  "name": "number-guess",
  "version": "1.0.0",
  "description": "A colorful number guessing game (1-100) with player stats and a leaderboard, built with React, TypeScript and Vite.",
  "keywords": [
    "react",
    "typescript",
    "vite",
    "game"
  ],
  "author": "Marc Tremblay",
  "license": "ISC",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "check-types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:spelling": "cspell lint --no-progress \"**\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "mutation-test": "stryker run",
    "dead-code": "knip",
    "duplication": "jscpd src",
    "deps:circular": "madge --circular --extensions ts,tsx --ts-config tsconfig.json src/",
    "quality": "pnpm run dead-code && pnpm run duplication && pnpm run deps:circular",
    "size": "size-limit",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run lint:spelling && pnpm run check-types && pnpm run quality && pnpm run build && pnpm run size && pnpm run test:coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "framer-motion": "^14.12.0",
    "mitt": "^3.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@size-limit/file": "^14.3.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "@vitest/coverage-v8": "^1.0.0",
    "@vitest/ui": "^1.0.0",
    "cspell": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-unicorn": "^77.0.0",
    "fast-check": "^4.10.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "jsdom": "^30.1.1",
    "knip": "^6.44.2",
    "madge": "^8.0.0",
    "prettier": "^3.9.10",
    "size-limit": "^14.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "validate-branch-name": "^1.3.2",
    "vite": "5.4.21",
    "vitest": "^1.0.0"
  },
  "pnpm": {
    "audit": {
      "ignore": {
        "GHSA-238p-pnpm-9mq7": {
          "reason": "Low-severity vulnerability in transitive dependency. Will be fixed in a future update."
        }
      }
    }
  }
}
